{
  "name": "glasscraft",
  "version": "1.0.0",
  "description": "Glass-style Minecraft launcher (1.21.11)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.glasscraft",
    "productName": "GlassCraft",
    "files": [
      "**/*",
      "!dist/**",
      "!*.bat",
      "!.github/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "GlassCraft.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "GlassCraft-Setup.exe"
    }
  }
}
